# Local dev: full URL to your Express API (must include /api).
VITE_API_URL=http://localhost:5000/api

# Vercel production (recommended): leave VITE_API_URL unset so the app calls same-origin /api.
# Then add server-side env in Vercel dashboard only:
#   API_BACKEND_URL=https://your-host.onrender.com/api
