# Paste these into Vercel → Project → Settings → Environment Variables
# (Production + Preview). Then Redeploy.

# Required — public HTTPS URL of your Express app, MUST end with /api (no trailing slash after "api")
API_BACKEND_URL=https://your-api.onrender.com/api

# On that Express host, set ALLOW_ANONYMOUS_ACCESS=true (+ EMAIL_USER / EMAIL_PASS) for login-free data.

# Optional — only if you want the browser to call the API directly (must be HTTPS, not localhost).
# Leave unset to use the built-in /api proxy above.
# VITE_API_URL=
