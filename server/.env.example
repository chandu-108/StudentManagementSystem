PORT=5000
MONGO_URI=mongodb://localhost:27017/student-management
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh

# Admin login (also used to match Admin user for anonymous mode)
EMAIL_USER=admin@example.com
EMAIL_PASS=your-secure-password

# Login-free API: attach first Admin user when no Bearer token is sent (required for demo UI + data).
# Set on Render/Railway/etc. if the frontend runs without login.
ALLOW_ANONYMOUS_ACCESS=true
